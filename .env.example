# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development

# Authentication (Auth.js)
AUTH_SECRET=aaaAaaAAaaAA1AaAaaaA1aAAaaA1aa11aAaAaAAAaAAAaAaA1

# API
API_URL=https://dev.atrupe.com.br

# API_LOG
SHOW_API_REQUEST_LOG=true
SHOW_API_RESPONSE_LOG=false
SHOW_API_ERROR_LOG=true

# ─── Tracking / Analytics (opcional) ─────────────────────────────────────────
# A config central (src/config/tracking.ts) já usa estes valores como padrão.
# Descomente apenas para apontar para outro container/pixel — sem estas vars,
# os IDs de produção são usados normalmente.
# NEXT_PUBLIC_GTM_ID=GTM-WV53Q7X7
# NEXT_PUBLIC_GA4_ID=G-V8B7SDZ187
# NEXT_PUBLIC_OPENAI_PIXEL_ID=5TZxCTcQhmzhW7DZ6ZHPFk
#
# Ativação do OpenAI Pixel — DESLIGADO por padrão. Ligue em homolog para a
# validação do §8; em produção, somente após a decisão de consentimento (§4.2).
# NEXT_PUBLIC_OPENAI_PIXEL_ENABLED=false

# ─── E2E / Playwright (apenas para testes automatizados) ─────────────────────
# URL base do frontend de homologação (configurar em GitHub → Secrets and
# variables → Actions)
# E2E_BASE_URL=https://homolog.atrupe.com.br

# URL do backend de homologação (para o health check no pipeline)
# BACKEND_HOMOLOG_URL=https://dev.atrupe.com.br

# Credenciais da conta de smoke test dedicada em homologação
# (NUNCA commitar valores reais — usar Secrets no GitHub)
# E2E_USER_EMAIL=smoke-e2e@atrupe.com.br
# E2E_USER_PASSWORD=

# Credenciais usadas pelos scripts de mapeamento em openspec/analise/ferramentas/
# (contas do ambiente de desenvolvimento — NUNCA commitar valores reais)
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# ─── Atrupe PRO legado (ambiente de testes e demonstração) ───────────────────
# Usado só pelos levantamentos do legado (openspec/analise/). Preencher com a
# conta de suporte do ambiente de testes — NUNCA commitar valores reais.
# LEGACY_URL=https://pro.atrupe.com.br
# LEGACY_USER=
# LEGACY_PASSWORD=

# ─── Ambiente local: plano e recursos simulados ──────────────────────────────
# A API de dev devolve `plan.features` vazio mesmo no FULL, e o menu lateral
# esconde tudo que tem gate. Esta lista libera os recursos do PRO/ELITE/FULL
# no `npm run dev` (ver usePlanFeatures). Precisa estar neste arquivo, e não
# só no shell. Para testar o FULL, acrescentar stock_control,invoice_entry.
NEXT_PUBLIC_DEV_FEATURES=accounts_receivable,accounts_payable,cash_control,pdv_screen,credit_limit_configuration,bank_account_creation,bank_account_delete,bank_account_provision,bank_account_cash_control_switch,payment_condition_operator_fee,payment_difference,transaction_cancel_reasons,can_bill_on_delivery_and_checkout,quotation_quick_sale,quotation_rejection_reasons,quotation_require_rejection_reason,quotation_status_configuration,quotation_status_column,pdf_show_item_details,service_order_cancellation_reason,service_order_current_phase,basic_management,basic_quotations,basic_service_orders,client_additional_tabs,client_responsible_management,supplier_additional_tabs,sectors_configuration,multiple_companies,product_composition,product_production_stages,cost_base,pricing_center,production_manager,productivity_tracking,delivery_production_tabs,delivery_production_stages,delivery_stage_status_change

# A conta de teste bloqueia toda noite por inadimplência simulada; `true` ignora
# o bloqueio só no front (a API continua recusando criar orçamento).
DEV_IGNORE_BLOCK=true

# Nome do plano mostrado para a conta de teste (a API de dev não troca plano).
# Apague a linha para voltar ao plano real. Valores: START, LITE, PRO, ELITE, FULL
DEV_PLAN_NAME=ELITE
